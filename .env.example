# Start on loopback with python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000 --no-access-log
DAYMARK_ORIGIN=http://localhost:8000
DAYMARK_SYNC_SECONDS=300

# Optional. Required when DAYMARK_ORIGIN uses HTTPS. Set a unique password of at least 12 characters.
DAYMARK_PASSWORD=
# Optional database location. Default is data/daymark.sqlite3 beside the source.
# DAYMARK_DB=/absolute/private/path/daymark.sqlite3

# Optional. Generate a Fernet key and keep it alongside your database backup.
DAYMARK_TOKEN_KEY=
DAYMARK_GOOGLE_CLIENT_ID=
DAYMARK_GOOGLE_CLIENT_SECRET=
DAYMARK_MICROSOFT_CLIENT_ID=
DAYMARK_MICROSOFT_CLIENT_SECRET=
DAYMARK_MICROSOFT_TENANT=common
DAYMARK_MICROSOFT_MAIL=0

# Optional. Use only your own LMS calendar export link.
DAYMARK_BENNETT_ICS=
# Optional. A local CSV or ICS timetable that you own.
DAYMARK_CAMU_FILE=
