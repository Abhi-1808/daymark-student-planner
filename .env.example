# Reference values only: the backend does not automatically load .env files.
# Export the settings you need in the terminal that starts the backend.
DATABASE_URL=sqlite:///./calendar_tasks.db
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_SECONDS=300
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_SECRET_FILE=credentials.json
GOOGLE_TOKEN_FILE=google-token.json
GOOGLE_CALENDAR_ID=primary
CAMU_SESSION_FILE=camu-session.json

# Classic Outlook uses your existing Bennett profile on Windows; no registration
# is needed. Alternatively enter Graph registration in Settings, saved privately
# in outlook-connection.json. Register a Microsoft native desktop public client with
# http://localhost:8000/api/outlook/callback and delegated Calendars.ReadBasic,
# Mail.ReadBasic permissions. No client secret is required.

# Optional private Android access. scripts/run_local.py --phone reads these from
# your connected Tailscale account automatically. Keep the backend on loopback.
# DAYMARK_PRIVATE_ORIGIN=https://your-computer.your-tailnet.ts.net
# DAYMARK_PRIVATE_USER=your-tailscale-login@example.com

# Optional: set these privately, never in Git-tracked files.
# CAMU_BROWSER_PATH=path/to/chrome
# LMS_ICAL_FILE=lms-calendar.ics
# LMS_ICAL_URL=your-private-Bennett-calendar-subscription
